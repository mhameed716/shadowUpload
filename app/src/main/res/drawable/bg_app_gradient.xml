<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية سيبرانية متدرجة مع شبكة خفيفة -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/shadow_black"
                android:startColor="#0A1420"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#00000000"
                android:endColor="#1A00F0FF"
                android:startColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>

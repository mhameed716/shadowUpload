<?xml version="1.0" encoding="utf-8"?>
<!-- بلاطة مركز النقل عند الضغط -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_cyan">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_surface" />
            <corners android:radius="@dimen/radius_m" />
            <stroke
                android:width="1dp"
                android:color="@color/shadow_outline" />
        </shape>
    </item>
</ripple>

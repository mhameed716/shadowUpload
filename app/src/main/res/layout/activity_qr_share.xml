<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة المشاركة عبر QR -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_s"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_l">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/a11y_back"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Text.ShadowUpload.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/qr_title" />
        </LinearLayout>

        <!-- مبدّل الاستقبال/الإرسال -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsQrMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:tabIndicatorColor="@color/neon_cyan"
            app:tabIndicatorFullWidth="false"
            app:tabMode="fixed"
            app:tabRippleColor="@color/ripple_cyan"
            app:tabSelectedTextColor="@color/neon_cyan"
            app:tabTextColor="@color/text_tertiary" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:id="@+id/tvQrHint"
                    style="@style/Text.ShadowUpload.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/qr_show_code" />

                <!-- حاوية رمز QR (تُرسم برمجياً) -->
                <FrameLayout
                    android:id="@+id/qrContainer"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_neon_card"
                    android:padding="@dimen/space_m">

                    <ImageView
                        android:id="@+id/ivQrCode"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/a11y_qr_code"
                        android:scaleType="fitCenter" />

                    <ProgressBar
                        android:id="@+id/pbQrBusy"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/neon_cyan"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- حاوية الكاميرا للمسح -->
                <FrameLayout
                    android:id="@+id/scanContainer"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_neon_card"
                    android:visibility="gone" />

                <!-- الرمز النصي -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:background="@drawable/bg_code_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <TextView
                        android:id="@+id/tvQrToken"
                        style="@style/Text.ShadowUpload.Mono"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/neon_cyan"
                        android:textIsSelectable="true" />

                    <ImageButton
                        android:id="@+id/btnCopyToken"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/qr_copy_link"
                        android:src="@drawable/ic_check" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvQrExpiry"
                    style="@style/Text.ShadowUpload.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s" />

                <TextView
                    android:id="@+id/tvHandshake"
                    style="@style/Text.ShadowUpload.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textColor="@color/neon_lime"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanQr"
                    style="@style/Widget.ShadowUpload.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/join_scan_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegenerate"
                    style="@style/Widget.ShadowUpload.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/qr_regenerate" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

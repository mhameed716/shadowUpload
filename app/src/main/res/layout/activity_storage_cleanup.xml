<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة تنظيف التخزين -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_s">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/a11y_back"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Text.ShadowUpload.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/cleaner_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReclaimable"
            style="@style/Text.ShadowUpload.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center"
            android:textColor="@color/neon_lime" />

        <TextView
            style="@style/Text.ShadowUpload.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/cleaner_scan" />

        <ProgressBar
            android:id="@+id/pbScan"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="@dimen/space_l"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_track" />

        <TextView
            android:id="@+id/tvScanProgress"
            style="@style/Text.ShadowUpload.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_hub_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_m">

                <CheckBox
                    android:id="@+id/cbTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/neon_cyan"
                    android:checked="true" />

                <TextView
                    style="@style/Text.ShadowUpload.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cleaner_temp_files"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvTempSize"
                    style="@style/Text.ShadowUpload.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_hub_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_m">

                <CheckBox
                    android:id="@+id/cbEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/neon_cyan"
                    android:checked="true" />

                <TextView
                    style="@style/Text.ShadowUpload.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cleaner_empty_dirs"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvEmptyCount"
                    style="@style/Text.ShadowUpload.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowDuplicates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_hub_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_m">

                <CheckBox
                    android:id="@+id/cbDuplicates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/neon_cyan" />

                <TextView
                    style="@style/Text.ShadowUpload.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cleaner_duplicates"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvDuplicateSize"
                    style="@style/Text.ShadowUpload.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            style="@style/Widget.ShadowUpload.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/cleaner_scan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCleanNow"
            style="@style/Widget.ShadowUpload.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/cleaner_clean_now" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

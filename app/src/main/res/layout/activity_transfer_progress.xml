<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة تقدم النقل -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <TextView
            android:id="@+id/tvTransferState"
            style="@style/Text.ShadowUpload.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/transfer_preparing" />

        <TextView
            android:id="@+id/tvTransferFile"
            style="@style/Text.ShadowUpload.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:ellipsize="middle"
            android:gravity="center"
            android:maxLines="1" />

        <ProgressBar
            android:id="@+id/pbTransfer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/space_xl"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_track" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPercent"
                style="@style/Text.ShadowUpload.Mono"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/neon_cyan" />

            <TextView
                android:id="@+id/tvSpeed"
                style="@style/Text.ShadowUpload.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/neon_magenta" />

            <TextView
                android:id="@+id/tvEta"
                style="@style/Text.ShadowUpload.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTransferDetail"
            style="@style/Text.ShadowUpload.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelTransfer"
            style="@style/Widget.ShadowUpload.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/transfer_cancel" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

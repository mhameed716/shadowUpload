<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة إعدادات WiFi والمساعدة -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_s">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/a11y_back"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Text.ShadowUpload.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:text="@string/wifi_title" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:cardBackgroundColor="@color/shadow_surface"
            app:cardCornerRadius="@dimen/radius_m"
            app:strokeColor="@color/shadow_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:id="@+id/tvWifiState"
                    style="@style/Text.ShadowUpload.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvPortInfo"
                    style="@style/Text.ShadowUpload.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWifiSettings"
            style="@style/Widget.ShadowUpload.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/wifi_open_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHotspot"
            style="@style/Widget.ShadowUpload.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/wifi_open_hotspot" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnose"
            style="@style/Widget.ShadowUpload.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/wifi_diagnose" />

        <TextView
            android:id="@+id/tvDiagnoseResult"
            style="@style/Text.ShadowUpload.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:visibility="gone" />

        <TextView
            style="@style/Text.ShadowUpload.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/wifi_firewall_hint" />

        <!-- الأسئلة الشائعة -->
        <TextView
            style="@style/Text.ShadowUpload.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/help_title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:cardBackgroundColor="@color/shadow_surface"
            app:cardCornerRadius="@dimen/radius_m"
            app:strokeColor="@color/shadow_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    style="@style/Text.ShadowUpload.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/help_q1"
                    android:textColor="@color/neon_cyan" />

                <TextView
                    style="@style/Text.ShadowUpload.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_m"
                    android:text="@string/help_a1" />

                <TextView
                    style="@style/Text.ShadowUpload.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/help_q2"
                    android:textColor="@color/neon_cyan" />

                <TextView
                    style="@style/Text.ShadowUpload.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_m"
                    android:text="@string/help_a2" />

                <TextView
                    style="@style/Text.ShadowUpload.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/help_q3"
                    android:textColor="@color/neon_cyan" />

                <TextView
                    style="@style/Text.ShadowUpload.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_m"
                    android:text="@string/help_a3" />

                <TextView
                    style="@style/Text.ShadowUpload.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/help_q4"
                    android:textColor="@color/neon_cyan" />

                <TextView
                    style="@style/Text.ShadowUpload.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/help_a4" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

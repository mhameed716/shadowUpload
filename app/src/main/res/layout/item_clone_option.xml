<?xml version="1.0" encoding="utf-8"?>
<!-- خيار ضمن نسخ الهاتف -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_s"
    android:background="@drawable/bg_hub_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_m"
    android:paddingBottom="@dimen/space_s">

    <CheckBox
        android:id="@+id/cbCloneOption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/neon_cyan" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCloneTitle"
            style="@style/Text.ShadowUpload.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvCloneDesc"
            style="@style/Text.ShadowUpload.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>

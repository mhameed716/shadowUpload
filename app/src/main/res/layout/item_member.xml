<?xml version="1.0" encoding="utf-8"?>
<!-- عضو في مجموعة -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xs"
    android:background="@drawable/bg_hub_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_m">

    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_dot_online" />

    <TextView
        android:id="@+id/tvMemberName"
        style="@style/Text.ShadowUpload.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvMemberIp"
        style="@style/Text.ShadowUpload.Mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_tertiary" />
</LinearLayout>
